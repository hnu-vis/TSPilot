# Model connections (model name, API key, and base URL) are managed in the web UI
# and saved under configs/models/ai/. Do not place model credentials in this file.

# Backend
TSPILOT_BACKEND_HOST=0.0.0.0
TSPILOT_BACKEND_PORT=5680

# Local project paths
TSPILOT_ROOT=.
TSPILOT_DATABASE_CONFIG_DIR=
TSPILOT_KNOWLEDGE_BASE_DIR=
# Optional override; defaults to configs/timeouts.yaml under TSPILOT_ROOT.
TSPILOT_TIMEOUT_CONFIG_PATH=

# Conversation trace logging
TSPILOT_CONVERSATION_LOG_ENABLED=true
TSPILOT_CONVERSATION_LOG_DIR=
